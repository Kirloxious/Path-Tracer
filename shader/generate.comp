#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/rng.glsl"
#include "common/scene_buffers.glsl"
#include "common/envmap.glsl"

layout(binding = 5) uniform sampler2D gbuf_pos_matid_tex;
layout(binding = 6) uniform sampler2D gbuf_normal_tex;
layout(location = 0) uniform ivec2 image_size;
layout(location = 1) uniform int frame_index;
layout(location = 3) uniform int time;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    vec4 pm = texelFetch(gbuf_pos_matid_tex, px, 0);
    vec3 n = texelFetch(gbuf_normal_tex, px, 0).xyz;

    // Build the whole PathState in registers and store it once. Writing the fields
    // individually turned one contiguous 96-byte store into eight scattered ones to the
    // same cache line, and every pixel on screen pays it.
    PathState s;
    s.throughput = vec3(1);
    s.radiance = vec3(0);
    s.bounce = 0;
    s.rng_state = init_rng(pid, frame_index, uint(time));
    // FLAG_SPECULAR_PREFIX starts set: with no vertices behind it the prefix is
    // vacuously all-specular, so a diffuse primary is its own resampling vertex and
    // behaves exactly as before. A mirror primary keeps the flag through shade_metal
    // and hands it to whatever diffuse surface the reflection lands on.
    s.flags = FLAG_FRONT_FACE | FLAG_SPECULAR_PREFIX; // raster pass renders front faces only
    s.pdf_bsdf = 0.0;
    s.hit_triangle_idx = 0u;

    // Sky test: gbuffer normal of length zero means no primitive was rasterized.
    // Any real hit has a unit normal.
    if (dot(n, n) < 0.5) {
        // Primary sky — sample the envmap (or return black if unbound). Reconstruct
        // the view ray from pixel coords via the inverse camera matrices. Directly
        // visible, so no indirect clamp applies here.
        vec2 ndc = (vec2(px) + 0.5) / vec2(image_size) * 2.0 - 1.0;
        vec4 clip = inv_proj_matrix * vec4(ndc.x, ndc.y, -1.0, 1.0);
        vec3 view_dir = normalize(mat3(inv_view_matrix) * clip.xyz);
        s.radiance = sample_envmap(view_dir);
        s.hit_point = vec3(0.0);
        s.hit_normal = vec3(0.0);
        s.hit_matid = 0u;
        s.ray_origin = camera_position;
        s.ray_dir = view_dir;
        states[pid] = s;
        return; // path stays out of every queue
    }

    uint matid = floatBitsToUint(pm.w);
    s.hit_point = pm.xyz;
    s.hit_normal = normalize(n);
    s.hit_matid = matid;
    // Camera-to-hit direction. shade_metal/dielectric reflect/refract `ray_dir` on the
    // first bounce, so it must be initialized — the gbuffer-fed primary "ray" is the view ray.
    s.ray_dir = normalize(pm.xyz - camera_position);
    s.ray_origin = camera_position;
    states[pid] = s;

    // ray_queue_push(pid);
    // Skip the first trace by pushing straight to the per-material hit queue.
    // Subsequent bounces go through trace.comp
    uint t = mats[matid].type;
    if (t == MAT_LAMBERTIAN) hit_lambertian_push(pid);
    else if (t == MAT_METAL) hit_metal_push(pid);
    else if (t == MAT_DIELECTRIC) hit_dielectric_push(pid);
    else hit_emissive_push(pid);
}
