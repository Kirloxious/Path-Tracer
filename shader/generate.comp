#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/rng.glsl"
#include "common/scene_buffers.glsl"
#include "common/gbuffer.glsl"
#include "common/envmap.glsl"


void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    vec3 n = gbuffer_raw_normal(px);

    // Built in registers and stored once: field-by-field writes become eight scattered stores.
    PathState s;
    s.throughput = vec3(1);
    s.radiance = vec3(0);
    s.bounce = 0;
    s.rng_state = sampler_seed(pid, uint(run_seed));
    // FLAG_SPECULAR_PREFIX starts set — with no vertices behind it the prefix is vacuously all
    // mirrors. FLAG_FRONT_FACE because the raster pass flips every normal toward the camera.
    s.flags = FLAG_FRONT_FACE | FLAG_SPECULAR_PREFIX;
    s.pdf_bsdf = 0.0;
    s.hit_triangle_idx = NO_TRIANGLE;

    if (gbuffer_is_sky(n)) {
        // Directly visible sky, so unclamped.
        vec2 ndc = (vec2(px) + 0.5) / vec2(image_size) * 2.0 - 1.0;
        // Reversed-Z with a [0,1] clip range puts the near plane at ndc.z = 1.
        vec4 clip = inv_proj_matrix * vec4(ndc.x, ndc.y, 1.0, 1.0);
        vec3 view_dir = normalize(mat3(inv_view_matrix) * clip.xyz);
        s.radiance = sample_envmap(view_dir);
        s.hit_point = vec3(0.0);
        s.hit_normal = vec3(0.0);
        s.hit_matid = 0u;
        s.ray_origin = camera_position;
        s.ray_dir = view_dir;
        states[pid] = s;
        return; // path stays out of every queue
    }

    uint matid = gbuffer_matid(px);
    vec3 P = gbuffer_world_pos(px, image_size);
    s.hit_point = P;
    s.hit_normal = normalize(n);
    s.hit_matid = matid;
    // The shade kernels scatter `ray_dir`, so the gbuffer primary needs its view ray.
    s.ray_dir = normalize(P - camera_position);
    s.ray_origin = camera_position;
    states[pid] = s;

    // Straight into the hit queues: the raster pass already did the primary trace.
    uint t = mats[matid].type;
    if (t == MAT_DIFFUSE || t == MAT_SPECULAR) hit_opaque_push(pid);
    else if (t == MAT_TRANSMISSIVE) hit_transmissive_push(pid);
    else hit_emissive_push(pid);
}
