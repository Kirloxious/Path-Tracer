#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/path_state.glsl"
#include "common/scene_buffers.glsl"
#include "common/gbuffer.glsl"
#include "common/constants.glsl"
#include "common/math.glsl"

// Read-write: accumulation and the moments are both running averages read back in place.
layout(rgba32f, binding = 0) uniform image2D accum_image;
layout(rg32f, binding = 3) uniform image2D moments_image;
layout(rgba16f, binding = 2) writeonly uniform image2D normals_image;


void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    vec3 sample_color = max(states[pid].radiance, vec3(0.0));
    if (any(isnan(sample_color)) || any(isinf(sample_color))) sample_color = vec3(0.0);

    vec3 raw_n = gbuffer_raw_normal(px);
    bool miss = gbuffer_is_sky(raw_n);
    vec3 N = miss ? vec3(0.0) : normalize(raw_n);
    uint matid = miss ? 0u : gbuffer_matid(px);

    // Averaged on the same schedule as the colour, so E[l^2] - E[l]^2 is the spread of the
    // samples behind this pixel's mean.
    float l = luminance(sample_color);
    vec2  sample_moments = vec2(l, l * l);

    vec3 accumulated;
    vec2 moments;
    if (frame_index <= 1) {
        accumulated = sample_color;
        moments = sample_moments;
    } else {
        float w = 1.0 / float(frame_index);
        accumulated = mix(imageLoad(accum_image, px).rgb, sample_color, w);
        moments = mix(imageLoad(moments_image, px).rg, sample_moments, w);
    }

    // Alpha: the sample count the denoiser divides the variance by.
    imageStore(accum_image, px, vec4(accumulated, float(max(frame_index, 1))));
    imageStore(moments_image, px, vec4(moments, 0.0, 0.0));

    float mat_type = miss ? 0.0 : float(mats[matid].type);
    imageStore(normals_image, px, vec4(N * 0.5 + 0.5, mat_type));
}
