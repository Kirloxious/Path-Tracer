#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/shadow_state.glsl"
#include "common/queue.glsl"
#include "common/bvh_traversal.glsl"
#include "common/geom.glsl"

void main() {
    uint qid = queue_thread_index();
    if (qid >= shadow_queue_count) return;
    uint pid = shadow_queue_idx[qid];

    vec3 hit_point = states[pid].hit_point;
    vec3 hit_n     = states[pid].hit_normal;
    uint tri_idx   = states[pid].hit_triangle_idx;

    ShadowState ss = shadow_states[pid];

    vec3 add = vec3(0.0);
    if (ss.nee_valid != 0.0) {
        vec3 origin = surface_ray_origin(hit_point, tri_idx, hit_n, ss.nee_dir);
        if (is_visible(origin, hit_point + ss.nee_dir * ss.nee_dist, int(tri_idx), int(ss.nee_tri))) {
            add += ss.nee_le;
        }
    }
    // The environment sits at infinity, so anything the ray meets occludes it; the distance
    // only has to clear the scene bounds.
    if (ss.env_valid != 0.0) {
        vec3 origin = surface_ray_origin(hit_point, tri_idx, hit_n, ss.env_dir);
        if (is_visible(origin, origin + ss.env_dir * 1e6, int(tri_idx), NO_SKIP_TRI)) {
            add += ss.env_le;
        }
    }

    if (dot(add, add) > 0.0) {
        states[pid].radiance = states[pid].radiance + add;
    }
}
