#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/shadow_state.glsl"
#include "common/queue.glsl"
#include "common/bvh_traversal.glsl"
#include "common/geom.glsl"

void main() {
    uint qid = gl_GlobalInvocationID.x;
    if (qid >= shadow_queue_count) return;
    uint pid = shadow_queue_idx[qid];

    // Analytic NEE only fires at bounce > 0 (bounce 0 uses ReSTIR with folded
    // visibility), so hit_triangle_idx is always valid here.
    uint  flags       = states[pid].flags;
    vec3  hit_point   = states[pid].hit_point;
    uint  tri_idx     = states[pid].hit_triangle_idx;
    bool  front_face  = (flags & FLAG_FRONT_FACE) != 0u;

    ShadowState ss = shadow_states[pid];

    vec3 offset_n = triangle_geom_normal(tri_idx, front_face);
    vec3 origin   = hit_point + 0.001 * offset_n;
    vec3 target   = hit_point + ss.nee_dir * ss.nee_dist;

    if (is_visible(origin, target)) {
        states[pid].radiance = states[pid].radiance + ss.nee_le;
    }
}
