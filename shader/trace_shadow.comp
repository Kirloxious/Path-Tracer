#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/shadow_state.glsl"
#include "common/queue.glsl"
#include "common/bvh_traversal.glsl"
#include "common/geom.glsl"

void main() {
    uint qid = gl_GlobalInvocationID.x;
    if (qid >= shadow_queue_count) return;
    uint pid = shadow_queue_idx[qid];

    uint  flags       = states[pid].flags;
    vec3  hit_point   = states[pid].hit_point;
    uint  tri_idx     = states[pid].hit_triangle_idx;
    bool  front_face  = (flags & FLAG_FRONT_FACE) != 0u;

    ShadowState ss = shadow_states[pid];

    // Primary hits do queue shadow rays (environment NEE, glass seen directly) and carry no
    // triangle, only the view-facing shading normal.
    vec3 offset_n = (tri_idx != NO_TRIANGLE) ? triangle_geom_normal(tri_idx, front_face) : states[pid].hit_normal;
    vec3 origin   = hit_point + 0.001 * offset_n;

    vec3 add = vec3(0.0);
    if (ss.nee_valid != 0.0 && is_visible(origin, hit_point + ss.nee_dir * ss.nee_dist)) {
        add += ss.nee_le;
    }
    // The environment sits at infinity, so anything the ray meets occludes it. The distance
    // only has to clear the scene bounds; is_visible shortens t_max by an epsilon, which at
    // this magnitude would round away, hence a value well short of what a float can hold.
    if (ss.env_valid != 0.0 && is_visible(origin, origin + ss.env_dir * 1e6)) {
        add += ss.env_le;
    }

    if (dot(add, add) > 0.0) {
        states[pid].radiance = states[pid].radiance + add;
    }
}
