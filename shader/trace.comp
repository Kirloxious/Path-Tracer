#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/bvh_traversal.glsl"
#include "common/envmap.glsl"
#include "common/clamp.glsl"

void main() {
    uint qid = gl_GlobalInvocationID.x;
    if (qid >= ray_queue_count) return;
    uint pid = ray_queue_idx[qid];

    Ray r;
    r.origin    = states[pid].ray_origin;
    r.direction = states[pid].ray_dir;

    HitRecord hit;
    int       tri_index;
    if (!world_hit_stackless(r, 0.001, 1e30, hit, tri_index)) {
        // Miss — env contribution × throughput. Path dies (does not enqueue).
        // v1 uses miss-sampling only; no MIS weight needed here (no NEE toward env).
        // Only continuation rays reach trace.comp — generate.comp handles the primary
        // sky directly — so this contribution is always indirect.
        states[pid].radiance += clamp_indirect(states[pid].throughput * sample_envmap(r.direction));
        return;
    }

    // One read-modify-write on `flags`, not two. The old pair of `|=` / `&=~` branches
    // both touch the same dword, so a warp that diverges on front_face paid two full
    // round-trips to it instead of one.
    uint flags = states[pid].flags;
    flags = hit.front_face ? (flags | FLAG_FRONT_FACE) : (flags & ~FLAG_FRONT_FACE);

    states[pid].hit_point        = hit.point;
    states[pid].hit_normal       = hit.normal;
    states[pid].hit_matid        = hit.mat_index;
    states[pid].hit_triangle_idx = uint(tri_index);
    states[pid].flags            = flags;

    uint t = mats[hit.mat_index].type;
    if      (t == MAT_DIFFUSE || t == MAT_SPECULAR) hit_opaque_push(pid);
    else if (t == MAT_TRANSMISSIVE)                 hit_transmissive_push(pid);
    else                                            hit_emissive_push(pid);
}
