#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common/gbuffer.glsl"
#include "common/constants.glsl"
#include "common/bsdf.glsl"

// Samplers, not images: pass 0 reads rgba32f `accum` and passes 1-3 rgba16f targets, which one
// image format qualifier cannot cover, and the 25-tap kernel benefits from the texture cache.
layout(binding = 0) uniform sampler2D src_tex;
layout(binding = 1) uniform sampler2D normals_tex;
// Alpha carries this pass's filtered variance to the next.
layout(rgba16f, binding = 2) writeonly uniform image2D dst_image;
// Luminance moments and, in accum's alpha, the sample count: a per-pixel variance for the colour
// edge-stop, so a converged pixel stops filtering while a disoccluded neighbour keeps going.
layout(binding = 3) uniform sampler2D moments_tex;
layout(binding = 4) uniform sampler2D history_tex;

layout(location = 0) uniform int step_size;
layout(location = 1) uniform float sigma_color_scale;
layout(location = 2) uniform float sigma_normal;
// Plane-distance tolerance at unit view depth, scaled by depth: a pixel spans more world space
// further away.
layout(location = 3) uniform float sigma_plane;
// Pass 0 derives variance from the moments; later passes read the filtered variance from
// `src_tex.a`, which in pass 0 (`accum`) holds the sample count instead.
layout(location = 4) uniform int first_pass;

const float h[5] = float[5](1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

// Colour edge-stop scale for specular and transmissive pixels, by roughness. The edge-stops
// describe the surface, not the image it reflects, so a mirror's sharp reflection must be left
// nearly alone while a rough lobe has already blurred it. 0.6 tuned on the mirror-floor scene.
// Filtering in reflection space would need the diffuse and specular signals separated.
const float SPECULAR_SIGMA_MIRROR = 0.6;  // at roughness 0
const float SPECULAR_SIGMA_ROUGH  = 1.0;  // at or above SPECULAR_ROUGHNESS_FULL
const float SPECULAR_ROUGHNESS_FULL = 0.4;

// Floor under the colour sigma, in demodulated luminance. Without it a converged pixel's zero
// variance rejects every neighbour, and the filter switching off beside a still-noisy region
// reads as a texture change.
const float SIGMA_COLOR_FLOOR = 0.02;

// Below this many samples the moments are useless (zero variance at one sample, switching the
// filter off exactly where history was lost), so the spatial spread is used instead.
const float SHORT_HISTORY = 4.0;

// Keeps the fp16 variance finite: an inf becomes NaN in `w * w * var` on a rejected tap, and
// the next pass turns that into a permanently dead pixel. Far past where every tap is admitted.
const float MAX_VARIANCE = 1e4;

// Divide-by-zero guard for demodulation; below a dielectric's 0.04 F0, the smallest real tint.
const float ALBEDO_FLOOR = 0.02;

// The tint the primary vertex imparts. Filtering with it divided out averages the incident
// light, which is continuous across an albedo edge, and keeps the edge itself sharp.
//
// Per class: a conductor tints by F0, and a transmissive colour is absorption over a path
// length unknown here, so it demodulates by nothing.
vec3 demod_albedo(in Material m, in uint type) {
    vec3 a = bsdf_diffuse_albedo(m);
    if (type == MAT_SPECULAR) a = bsdf_f0(m);
    else if (type == MAT_TRANSMISSIVE) a = vec3(1.0);
    return max(a, vec3(ALBEDO_FLOOR));
}

// Squared standard error of a pixel's accumulated mean. The moments describe individual
// samples but the buffer holds their mean, so the edge-stop needs var / n — the sample variance
// alone never narrows as the image converges.
float mean_variance(ivec2 q) {
    vec2  m = texelFetch(moments_tex, q, 0).rg;
    float n = max(texelFetch(history_tex, q, 0).a, 1.0);
    return min(max(m.y - m.x * m.x, 0.0) / n, MAX_VARIANCE);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= image_size.x || p.y >= image_size.y) return;

    vec4 normals_sample = texelFetch(normals_tex, p, 0);
    vec4 src_p = texelFetch(src_tex, p, 0);
    vec3 c_p = src_p.rgb;
    vec3 n_p = normals_sample.rgb * 2.0 - 1.0;
    float mat_type = normals_sample.a;

    bool     sky_p = gbuffer_is_sky(gbuffer_raw_normal(p));
    Material mat_p = mats[sky_p ? 0u : gbuffer_matid(p)];

    // Emissives are noise-free, and filtering bleeds them across their silhouette.
    if (mat_type > 2.5) {
        imageStore(dst_image, p, vec4(c_p, 0.0));
        return;
    }

    // Primary sky is an exact envmap lookup.
    if (sky_p) {
        imageStore(dst_image, p, vec4(c_p, 0.0));
        return;
    }

    int  mat_class = int(mat_type);
    vec3 a_p = demod_albedo(mat_p, uint(mat_class));
    // The colour weight compares demodulated luminances, so the sigma must be demodulated too.
    float inv_lum_a_p = 1.0 / luminance(a_p);

    float history = max(texelFetch(history_tex, p, 0).a, 1.0);

    float var_p;
    if (first_pass != 0) {
        // 3x3 prefilter for the edge-stop only. Unsmoothed, a firefly inflates only its own sigma,
        // so the neighbours that would average it away reject it and it survives as a blotch.
        const float g[3] = float[3](0.25, 0.5, 0.25);
        float       var_mod = 0.0;
        for (int j = -1; j <= 1; ++j) {
            for (int i = -1; i <= 1; ++i) {
                var_mod += mean_variance(clamp(p + ivec2(i, j), ivec2(0), image_size - 1)) * g[i + 1] * g[j + 1];
            }
        }

        float stddev_mod = sqrt(var_mod);

        if (history < SHORT_HISTORY) {
            float s = 0.0;
            float s2 = 0.0;
            for (int j = -2; j <= 2; ++j) {
                for (int i = -2; i <= 2; ++i) {
                    float l = luminance(texelFetch(src_tex, clamp(p + ivec2(i, j), ivec2(0), image_size - 1), 0).rgb);
                    s += l;
                    s2 += l * l;
                }
            }
            // Already a spread of means, so no division by n.
            const float inv_taps = 1.0 / 25.0;
            float       mean = s * inv_taps;
            stddev_mod = max(stddev_mod, sqrt(max(s2 * inv_taps - mean * mean, 0.0)));
        }

        float stddev_demod = stddev_mod * inv_lum_a_p;
        var_p = min(stddev_demod * stddev_demod, MAX_VARIANCE);
    }
    else {
        var_p = src_p.a;
    }

    float stddev = sqrt(var_p);

    float sigma_c = sigma_color_scale * stddev + SIGMA_COLOR_FLOOR;

    // Specular and transmissive pixels are the noisiest — what a mirror reflects gets one NEE
    // sample per frame — so they are filtered too, with a tighter sigma (see SPECULAR_SIGMA_*).
    if (mat_type > 0.5) {
        sigma_c *= mix(SPECULAR_SIGMA_MIRROR, SPECULAR_SIGMA_ROUGH, clamp(mat_p.roughness / SPECULAR_ROUGHNESS_FULL, 0.0, 1.0));
    }

    float inv_sigma_color_sq = 1.0 / (sigma_c * sigma_c + 1e-6);

    float l_p = luminance(c_p / a_p);

    // Plane edge-stop: the normal weight cannot separate parallel surfaces, and at step 8 the
    // kernel reaches 16 px. In view space, where only the centre normal needs rotating.
    vec3  p_view      = gbuffer_view_pos(p, image_size);
    vec3  n_p_view    = mat3(view_matrix) * n_p;
    float inv_plane_t = 1.0 / (sigma_plane * max(abs(p_view.z), 1.0));

    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    float var_sum = 0.0;

    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            ivec2 q = p + ivec2(i, j) * step_size;

            // Skipped, not clamped: clamping counts an edge pixel up to five times.
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, image_size))) continue;

            bool centre = (i == 0 && j == 0);
            vec4 n_sample_q = centre ? normals_sample : texelFetch(normals_tex, q, 0);

            // No albedo factor reconciles two material classes — a mirror carries an image of
            // somewhere else — so a tap of another class is dropped.
            if (int(n_sample_q.a) != mat_class) continue;

            vec4 s_q = centre ? vec4(c_p, var_p) : texelFetch(src_tex, q, 0);
            vec3 a_q = centre ? a_p : demod_albedo(mats[gbuffer_matid(q)], uint(mat_class));
            vec3 demod_q = s_q.rgb / a_q;
            vec3 n_q = n_sample_q.rgb * 2.0 - 1.0;

            // Luminance, to match the luminance variance behind sigma_c.
            float dl = l_p - luminance(demod_q);
            float w_c = exp(-dl * dl * inv_sigma_color_sq);
            float w_n = pow(max(0.0, dot(n_p, n_q)), sigma_normal);
            float w_p = exp(-abs(dot(n_p_view, gbuffer_view_pos(q, image_size) - p_view)) * inv_plane_t);
            float w = w_c * w_n * w_p * h[i + 2] * h[j + 2];

            sum += demod_q * w;
            wsum += w;
            // Var[Σ w c / Σ w] for independent taps, so later passes size their edge-stop for the
            // noise that is left rather than blurring detail at the wide steps.
            float var_q = s_q.a;
            if (first_pass != 0) {
                float inv_lum_a_q = 1.0 / luminance(a_q);
                var_q = centre ? var_p : min(mean_variance(q) * inv_lum_a_q * inv_lum_a_q, MAX_VARIANCE);
            }
            var_sum += w * w * var_q;
        }
    }

    // Back into radiance; the variance stays demodulated for the next pass.
    bool  valid  = wsum > 1e-6;
    vec3  result = valid ? a_p * (sum / wsum) : c_p;
    float var_out = valid ? var_sum / (wsum * wsum) : var_p;
    imageStore(dst_image, p, vec4(result, min(var_out, MAX_VARIANCE)));
}
