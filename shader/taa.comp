#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;
#include "common/scene_buffers.glsl"
#include "common/gbuffer.glsl"
#include "common/constants.glsl"

layout(rgb10_a2, binding = 0) readonly  uniform image2D current_image; // tonemap output
layout(rgb10_a2, binding = 1) writeonly uniform image2D display_image;
layout(rgba16f,  binding = 2) writeonly uniform image2D taa_output_image; // next frame's history

layout(binding = TEX_TAA_HISTORY) uniform sampler2D taa_history_tex;         // previous frame's TAA output (LINEAR filtered)

layout(location = 0) uniform float blend_alpha;   // upper bound on history weight (e.g. 0.9)

// YCoCg keeps luma on one axis and chroma on the other two. Clipping the history in RGB
// bounds each channel independently, so a history sample that differs mostly in hue gets
// each of its channels dragged separately and comes back a different colour — the classic
// TAA edge fringing. In YCoCg the same rejection acts almost entirely on luma, which is
// where temporal disagreement actually lives.
vec3 rgb_to_ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 ycocg_to_rgb(vec3 c) {
    float t = c.x - c.z;
    return vec3(t + c.y, c.x + c.z, t - c.y);
}

// Move `history` toward `center` only as far as needed to bring it inside the AABB.
// A per-channel clamp moves each axis independently, which shifts the sample off the line
// between the two colours; clipping preserves its hue and only shortens the offset.
vec3 clip_to_aabb(vec3 history, vec3 center, vec3 extent) {
    vec3 offset = history - center;
    // Largest per-axis overshoot, as a multiple of the box half-size.
    vec3  units = abs(offset) / max(extent, vec3(1e-5));
    float worst = max(max(units.x, units.y), units.z);
    return (worst > 1.0) ? (center + offset / worst) : history;
}

// 5-tap Catmull-Rom bicubic — replaces bilinear history sampling to preserve high
// frequencies. Bilinear resampling each frame acts as a repeated 4-tap low-pass
// filter and is the dominant cause of the "TAA blur" look. Catmull-Rom's negative
// side lobes push back against that softening. Weights collapsed to bilinear tap
// centers via the offset12 trick so we spend 5 bilinear fetches instead of 16.
vec3 sample_history_catmull_rom(sampler2D tex, vec2 uv, vec2 tex_size) {
    vec2 sample_pos = uv * tex_size;
    vec2 tex_pos_1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - tex_pos_1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 tex_pos_0 = (tex_pos_1 - 1.0) / tex_size;
    vec2 tex_pos_3 = (tex_pos_1 + 2.0) / tex_size;
    vec2 tex_pos_12 = (tex_pos_1 + offset12) / tex_size;

    vec3 result = vec3(0.0);
    result += texture(tex, vec2(tex_pos_12.x, tex_pos_0.y)).rgb * w12.x * w0.y;
    result += texture(tex, vec2(tex_pos_0.x,  tex_pos_12.y)).rgb * w0.x  * w12.y;
    result += texture(tex, vec2(tex_pos_12.x, tex_pos_12.y)).rgb * w12.x * w12.y;
    result += texture(tex, vec2(tex_pos_3.x,  tex_pos_12.y)).rgb * w3.x  * w12.y;
    result += texture(tex, vec2(tex_pos_12.x, tex_pos_3.y)).rgb * w12.x * w3.y;
    return result;
}

void taa_store(ivec2 px, vec3 c) {
    imageStore(display_image, px, vec4(c, 1.0));
    imageStore(taa_output_image, px, vec4(c, 1.0));
}

// Where this pixel's content sits, for reprojection: the primary hit as a point, or for sky
// the view direction with w = 0, which reprojects the environment through the previous
// rotation alone — it is infinitely far, so camera translation must not move it.
vec4 taa_reprojection_target(ivec2 px) {
    if (!gbuffer_is_sky(gbuffer_raw_normal(px))) {
        return vec4(gbuffer_world_pos(px, image_size), 1.0);
    }
    vec2 ndc  = (vec2(px) + 0.5) / vec2(image_size) * 2.0 - 1.0;
    // Reversed-Z with a [0,1] clip range puts the near plane at ndc.z = 1.
    vec4 near = inv_proj_matrix * vec4(ndc, 1.0, 1.0);
    return vec4(mat3(inv_view_matrix) * (near.xyz / near.w), 0.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, image_size))) return;

    vec3 cur = imageLoad(current_image, px).rgb;

    // Frame 1 (post-reset) has no valid history — pass current through untouched.
    if (history_frames <= 1) {
        taa_store(px, cur);
        return;
    }

    // Through the un-jittered previous view*proj (see camera.cpp: prev_view_proj is
    // deliberately built from baseProjection).
    vec4 clip_prev = prev_view_proj_matrix * taa_reprojection_target(px);
    if (clip_prev.w <= 0.0) {
        taa_store(px, cur);
        return;
    }
    vec2 ndc_prev = clip_prev.xy / clip_prev.w;
    vec2 uv_prev  = ndc_prev * 0.5 + 0.5;

    if (any(lessThan(uv_prev, vec2(0.0))) || any(greaterThan(uv_prev, vec2(1.0)))) {
        taa_store(px, cur);
        return;
    }

    vec3 hist = sample_history_catmull_rom(taa_history_tex, uv_prev, vec2(image_size));
    // Catmull-Rom's negative lobes can dip below zero on high-contrast edges — the
    // neighborhood clamp below re-bounds the value into the valid color range, but
    // clamp to 0 first so a stray negative can't poison the min() side of the AABB.
    hist = max(hist, vec3(0.0));

    // Neighbourhood rejection — this is what stops ghosting when a surface's shading has
    // changed between frames (moving lights, still-converging noise).
    //
    // A min/max AABB over the 3x3 is what this used to build, and it is too permissive: one
    // outlier neighbour widens the box enough to let a stale sample through. Using the mean
    // and standard deviation instead sizes the box by how much the neighbourhood actually
    // varies, so a converged region clips tightly while a genuinely busy one stays loose.
    vec3 m1 = vec3(0.0); // sum
    vec3 m2 = vec3(0.0); // sum of squares
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(px + ivec2(dx, dy), ivec2(0), image_size - 1);
            vec3  c = rgb_to_ycocg(imageLoad(current_image, q).rgb);
            m1 += c;
            m2 += c * c;
        }
    }

    const float inv_n = 1.0 / 9.0;
    vec3        mean = m1 * inv_n;
    vec3        sigma = sqrt(max(m2 * inv_n - mean * mean, vec3(0.0)));

    // Box half-width in standard deviations. Lower rejects more history: crisper, but more
    // temporal noise. ~1 is the usual starting point.
    const float GAMMA = 1.0;
    vec3        extent = GAMMA * sigma;

    hist = ycocg_to_rgb(clip_to_aabb(rgb_to_ycocg(hist), mean, extent));
    // Clipping against a variance box can still land slightly out of gamut on a hard edge.
    hist = max(hist, vec3(0.0));

    // Ramp the history weight over the first few frames so early frames rely more on
    // fresh samples, then settle at `blend_alpha`. Matches the accum pass's spirit of
    // trusting history more as we collect more samples.
    float a = min(blend_alpha, 1.0 - 1.0 / float(history_frames));
    vec3  outc = mix(cur, hist, a);

    taa_store(px, outc);
}
