#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/bvh_traversal.glsl"
#include "common/rng.glsl"
#include "common/restir_common.glsl"
#include "common/restir_surface.glsl"
#include "common/uniform_locations.glsl"

layout(std430, binding = 18) restrict buffer RestirReservoirsCurrent {
    Reservoir reservoirs[];
};

// Spatial reuse reads from `spatial_input` and writes `reservoirs`. The two
// spatial passes ping-pong by swapping which underlying Buffer is bound to
// 18 vs 20 between dispatches.
layout(std430, binding = 20) restrict readonly buffer RestirSpatialInput {
    Reservoir spatial_input[];
};

layout(std430, binding = 24) restrict readonly buffer RestirSurfaceCurrent {
    RestirSurface surfaces[];
};

// No G-buffer reads: this pass works entirely in terms of resampling surfaces now.

layout(location = 0) uniform ivec2 image_size;
layout(location = 1) uniform int   frame_index;
layout(location = 2) uniform int   k_neighbors;
layout(location = 3) uniform int   time;
layout(location = 4) uniform float radius_pixels;
layout(location = 5) uniform int   pass_index;
// 0 on every spatial pass but the last. The chosen sample is re-validated by whichever
// pass runs last, so testing it in an intermediate pass buys nothing and costs a full
// screen's worth of BVH shadow traversals.
layout(location = 6) uniform int   test_visibility;
layout(location = LOC_RUN_SEED) uniform int     run_seed;
layout(location = LOC_SAMPLE_INDEX) uniform int sample_index;

const float NORMAL_DOT_THRESHOLD = 0.9;
const float WORLD_POS_DELTA      = 0.5;

// Upper bound on k_neighbors, fixing the size of the arrays the Z pass below needs. Sized
// past the k=5 the host dispatches so the uniform can be raised without editing the shader.
const int MAX_NEIGHBORS = 8;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    // Read self reservoir from the input buffer (binding 20).
    Reservoir cur = spatial_input[pid];

    // Neighbours are compared as resampling surfaces, not as G-buffer surfaces. Two
    // adjacent mirror-floor pixels rasterize the same flat quad — identical normal,
    // identical material — but reflect parts of the scene metres apart, and combining
    // their reservoirs on that basis would smear the reflection. The surfaces buffer is
    // what actually distinguishes them.
    RestirSurface self_surf = surfaces[pid];
    if (self_surf.valid == 0u) {
        // Sky, emissive, or a specular chain with no diffuse end — nothing to reuse.
        reservoirs[pid] = cur;
        return;
    }

    vec3 P      = self_surf.position;
    vec3 N      = self_surf.normal;
    vec3 V      = self_surf.view_dir;

    // Neighbour offsets come from the low-discrepancy sampler so that, over frames, the k
    // taps sweep the disc evenly rather than reclustering every frame. The reservoir
    // acceptance test keeps a PCG stream — see restir_initial for why the two are separate.
    // pass_index folds into both so the two spatial dispatches pick different neighbours.
    Sampler smp = sampler_init(sampler_seed(pid, uint(run_seed) + uint(pass_index) * 0x9e37u + 0x4093u), sample_index, 0u);
    uint    rng = (pid * 4093u + uint(frame_index) * 65537u + uint(time) * 92837u + uint(pass_index) * 19937u + 0xDEADBEEFu) | 1u;

    // Which neighbours were actually combined, for the Z pass after selection. Only these
    // contributed to cur.M, so only these can contribute to the divisor.
    uint  reused_pid[MAX_NEIGHBORS];
    float reused_M[MAX_NEIGHBORS];
    int   reused_count = 0;
    float own_M        = cur.M;

    int k = min(k_neighbors, MAX_NEIGHBORS);
    for (int i = 0; i < k; ++i) {
        // Polar offset, sqrt(r) for a uniform-area distribution over the disc. Tap i keeps
        // its own dimension group so it walks a stratified path across frames.
        sampler_set_dim(smp, uint(i));
        vec2  u     = sampler_2d(smp);
        float r2    = sqrt(u.x) * radius_pixels;
        float theta = u.y * 2.0 * PI;
        ivec2 off   = ivec2(round(vec2(r2 * cos(theta), r2 * sin(theta))));
        if (off.x == 0 && off.y == 0) continue;

        ivec2 npx = px + off;
        if (npx.x < 0 || npx.y < 0 || npx.x >= image_size.x || npx.y >= image_size.y) continue;
        uint npid = uint(npx.y * image_size.x + npx.x);

        // Validate the neighbour's resampling surface against ours: same material,
        // similar normal, no large world-space gap. Same thresholds as temporal.
        RestirSurface nb = surfaces[npid];
        if (nb.valid == 0u) continue;
        if (nb.matid != self_surf.matid) continue;
        if (dot(nb.normal, N) < NORMAL_DOT_THRESHOLD) continue;
        vec3 dp = nb.position - P;
        if (dot(dp, dp) > WORLD_POS_DELTA * WORLD_POS_DELTA) continue;

        Reservoir other = spatial_input[npid];
        if (other.M <= 0.0 || other.light_tri_idx == RESTIR_INVALID_TRI) continue;

        // Re-evaluate the neighbor's sample at *our* surface. Geometry and
        // BRDF terms shift because the receiver is different. Skip if the
        // sample doesn't even illuminate us (back-facing either way).
        float p_hat_at_self = restir_target_pdf(P, N, V, self_surf.matid, other.light_tri_idx, other.bary);
        if (p_hat_at_self <= 0.0) continue;

        reservoir_combine(cur, other, p_hat_at_self, rng);
        reused_pid[reused_count] = npid;
        reused_M[reused_count]   = other.M;
        reused_count++;
    }

    // Z: the sampling effort that could have produced the winner. A neighbour whose own
    // surface gives the winning sample a zero target pdf — it faces away, or the light faces
    // away from it — never had a chance to generate it, and counting its M in the divisor is
    // what darkened corners and silhouettes. cur.target_pdf is already the winner's p_hat
    // here, so the self term is free.
    float Z = (cur.target_pdf > 0.0) ? own_M : 0.0;
    for (int i = 0; i < reused_count; ++i) {
        RestirSurface nb = surfaces[reused_pid[i]];
        if (restir_target_pdf(nb.position, nb.normal, nb.view_dir, nb.matid, cur.light_tri_idx, cur.bary) > 0.0) {
            Z += reused_M[i];
        }
    }

    reservoir_finalize(cur, Z);

    // Shadow-test the (possibly updated) chosen sample at our surface. A
    // neighbor's sample was tested at the neighbor's surface, so visibility
    // here is not guaranteed — if we skip this on the final pass, light leaks
    // across silhouettes. Intermediate passes skip it: their output is only ever
    // consumed by the next spatial pass, which tests whatever sample survives.
    if (test_visibility != 0 && cur.W > 0.0 && cur.light_tri_idx != RESTIR_INVALID_TRI) {
        Triangle tri = triangles[cur.light_tri_idx];
        vec3     v0  = vertices[tri.indices.x].position;
        vec3     sp  = v0 + cur.bary.x * tri.e1 + cur.bary.y * tri.e2;
        if (!is_visible(restir_surface_offset_origin(self_surf), sp)) {
            cur.W = 0.0;
        }
    }

    reservoirs[pid] = cur;
}
