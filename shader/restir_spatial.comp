#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/bvh_traversal.glsl"
#include "common/rng.glsl"
#include "common/restir_common.glsl"
#include "common/restir_surface.glsl"

layout(std430, binding = BIND_RESERVOIRS_CURRENT) restrict buffer RestirReservoirsCurrent {
    Reservoir reservoirs[];
};

// The two spatial passes ping-pong by swapping the buffers bound at 18 and 20.
layout(std430, binding = BIND_RESERVOIRS_SPATIAL_INPUT) restrict readonly buffer RestirSpatialInput {
    Reservoir spatial_input[];
};

layout(std430, binding = BIND_SURFACES_CURRENT) restrict readonly buffer RestirSurfaceCurrent {
    RestirSurface surfaces[];
};

layout(location = 0) uniform int   k_neighbors;
layout(location = 1) uniform float radius_pixels;
layout(location = 2) uniform int   pass_index;
// 0 on every pass but the last, which tests whatever sample survives.
layout(location = 3) uniform int   test_visibility;

// Sizes the Z pass's arrays; above the host's k = 5 so the uniform can grow.
const int MAX_NEIGHBORS = 8;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    Reservoir cur = spatial_input[pid];

    // Compared as resampling surfaces, not G-buffer ones: adjacent mirror-floor pixels share a
    // quad but reflect surfaces metres apart.
    RestirSurface self_surf = surfaces[pid];
    if (self_surf.valid == 0u) {
        reservoirs[pid] = cur;
        return;
    }

    vec3 P      = self_surf.position;
    vec3 N      = self_surf.normal;
    vec3 V      = self_surf.view_dir;

    // Stratified tap offsets, white-noise acceptance tests (see restir_initial). pass_index
    // keeps the two passes on different neighbours.
    Sampler smp = sampler_init(sampler_seed(pid, run_seed + uint(pass_index) * 0x9e37u + 0x4093u), frame_index, 0u);
    uint    rng = pcg_seed(pid, time_seed, RESTIR_RNG_SPATIAL + uint(pass_index));

    // Only the neighbours actually combined can contribute to Z.
    uint  reused_pid[MAX_NEIGHBORS];
    float reused_M[MAX_NEIGHBORS];
    int   reused_count = 0;
    float own_M        = cur.M;

    int k = min(k_neighbors, MAX_NEIGHBORS);
    for (int i = 0; i < k; ++i) {
        // Uniform over the disc; tap i keeps its own dimension group across frames.
        sampler_set_dim(smp, uint(i));
        vec2  u     = sampler_2d(smp);
        float r2    = sqrt(u.x) * radius_pixels;
        float theta = u.y * 2.0 * PI;
        ivec2 off   = ivec2(round(vec2(r2 * cos(theta), r2 * sin(theta))));
        if (off.x == 0 && off.y == 0) continue;

        ivec2 npx = px + off;
        if (npx.x < 0 || npx.y < 0 || npx.x >= image_size.x || npx.y >= image_size.y) continue;
        uint npid = uint(npx.y * image_size.x + npx.x);

        RestirSurface nb = surfaces[npid];
        if (!restir_surfaces_similar(self_surf, nb)) continue;

        Reservoir other = spatial_input[npid];
        if (other.M <= 0.0 || other.light_tri_idx == RESTIR_INVALID_TRI) continue;

        float p_hat_at_self = restir_target_pdf(P, N, V, self_surf.matid, other.light_tri_idx, other.bary);
        if (p_hat_at_self <= 0.0) continue;

        reservoir_combine(cur, other, p_hat_at_self, rng);
        reused_pid[reused_count] = npid;
        reused_M[reused_count]   = other.M;
        reused_count++;
    }

    // See reservoir_finalize(). cur.target_pdf is already the winner's p_hat here.
    float Z = (cur.target_pdf > 0.0) ? own_M : 0.0;
    for (int i = 0; i < reused_count; ++i) {
        RestirSurface nb = surfaces[reused_pid[i]];
        if (restir_target_pdf(nb.position, nb.normal, nb.view_dir, nb.matid, cur.light_tri_idx, cur.bary) > 0.0) {
            Z += reused_M[i];
        }
    }

    reservoir_finalize(cur, Z);

    // A neighbour's sample was tested at the neighbour's surface; untested here, light leaks
    // across silhouettes.
    if (test_visibility != 0 && cur.W > 0.0 && cur.light_tri_idx != RESTIR_INVALID_TRI) {
        vec3 sp = light_point(triangles[cur.light_tri_idx], cur.bary);
        if (!is_visible(restir_surface_offset_origin(self_surf, sp), sp, NO_SKIP_TRI, int(cur.light_tri_idx))) {
            cur.W = 0.0;
        }
    }

    reservoirs[pid] = cur;
}
