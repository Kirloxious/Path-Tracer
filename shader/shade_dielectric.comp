#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/scene_buffers.glsl"
#include "common/rng.glsl"
#include "common/uniform_locations.glsl"
#include "common/geom.glsl"

layout(location = LOC_BOUNCE_INDEX) uniform int bounce_index;
layout(location = LOC_MAX_BOUNCES) uniform int max_bounces;

float reflectance(float cosine, float ref_idx) {
    cosine = clamp(cosine, 0.0, 1.0);
    float r0 = (1.0 - ref_idx) / (1.0 + ref_idx);
    r0 = r0 * r0;
    float x = 1.0 - cosine;
    float x2 = x * x;
    return r0 + (1.0 - r0) * x2 * x2 * x;
}

void main() {
    uint qid = gl_GlobalInvocationID.x;
    if (qid >= hit_dielectric_count) return;
    uint pid = hit_dielectric_idx[qid];

    PathState s = states[pid];
    uint rng = s.rng_state;

    Material mat = mats[s.hit_matid];
    vec3 N = s.hit_normal;
    bool front_face = (s.flags & FLAG_FRONT_FACE) != 0u;
    float ri = front_face ? (1.0 / mat.refractive_index) : mat.refractive_index;

    float cos_theta = clamp(dot(-s.ray_dir, N), 0.0, 1.0);
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

    vec3 dir;
    bool reflected_path = ri * sin_theta > 1.0 || reflectance(cos_theta, ri) > random_unilateral(rng);
    if (reflected_path) {
        dir = reflect(s.ray_dir, N);
    } else {
        dir = refract(s.ray_dir, N, ri);
        // Floating-point edge case: the analytic TIR guard above can disagree
        // with refract()'s internal `1 - ri²(1 - cos²) < 0` test near grazing
        // angles. When that happens refract() returns vec3(0); a zero direction
        // entering the ray queue makes inv_dir NaN in BVH traversal. Fall back
        // to reflection — the surface is effectively in TIR by either test.
        if (dot(dir, dir) < 1e-12) {
            dir = reflect(s.ray_dir, N);
            reflected_path = true;
        }
    }

    // Offset along the *geometric* normal: `N` (s.hit_normal) is the shading normal,
    // which on curved surfaces near silhouettes can point past the tangent plane and
    // shove the origin inside the primitive — that's the dragon's firefly noise.
    // At bounce 0, hit_triangle_idx isn't seeded by generate.comp; fall back to the
    // shading normal there (gbuffer for sphere primaries is the only affected case
    // and dielectric primaries are usually closed convex meshes where it's not visible).
    //   reflected:  ray bounces back into the side it came from → offset along +n
    //   refracted:  ray crosses through into the other side     → offset along -n
    vec3 offset_basis = (s.bounce > 0u) ? triangle_geom_normal(s.hit_triangle_idx, front_face) : N;
    vec3 offset_normal = reflected_path ? offset_basis : -offset_basis;
    s.ray_origin = s.hit_point + 0.001 * offset_normal;
    s.ray_dir = dir;
    // Dielectric is colorless (mat_color = 1) — leave throughput alone.
    s.bounce++;
    // The reflect-vs-refract branch above is a coin flip on this kernel's RNG, so
    // restir_initial's deterministic walk never follows a dielectric. Leave the chain.
    s.flags &= ~(FLAG_PREV_NON_SPECULAR | FLAG_RESTIR_HANDLED | FLAG_SPECULAR_PREFIX); // specular bounce — no MIS weighting on next emissive, ReSTIR's primary scope doesn't extend past a specular interface

    bool alive = true;
    if (s.bounce > 2) {
        // Survival probability is capped at 0.95. Uncapped, a throughput that has
        // grown past 1 through earlier roulette divisions gives p > 1, and
        // `random_unilateral() > p` can then never fire — roulette stops terminating
        // anything and every path runs to max_bounces. The `p <= 0` early kill is
        // kept so a fully absorbed path still dies immediately.
        float p = min(max(s.throughput.r, max(s.throughput.g, s.throughput.b)), 0.95);
        if (p <= 0.0 || random_unilateral(rng) > p) alive = false;
        else s.throughput /= p;
    }

    s.rng_state = rng;
    states[pid] = s;

    if (alive && bounce_index + 1 < max_bounces) {
        ray_queue_push(pid);
    }
}
