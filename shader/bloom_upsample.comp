#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

// 3x3 tent-filter upsample, additively blended into the destination mip. On
// the final pass the destination is the HDR image itself and `strength` scales
// the contribution.

layout(binding = 0) uniform sampler2D src_tex;                    // smaller mip
layout(rgba16f, binding = 1) uniform image2D dst_image;           // larger mip (or hdr)

layout(location = 0) uniform ivec2 dst_size;
layout(location = 1) uniform float radius;   // tent-filter radius in *destination* texels
layout(location = 2) uniform float strength; // final-blend gain (1.0 for intermediate mips)

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= dst_size.x || p.y >= dst_size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(dst_size);
    vec2 ts = radius / vec2(textureSize(src_tex, 0));

    // 3x3 tent kernel (1 2 1 / 2 4 2 / 1 2 1) / 16.
    vec3 s =
        textureLod(src_tex, uv + vec2(-ts.x, -ts.y), 0.0).rgb * 1.0 +
        textureLod(src_tex, uv + vec2( 0.0,  -ts.y), 0.0).rgb * 2.0 +
        textureLod(src_tex, uv + vec2( ts.x, -ts.y), 0.0).rgb * 1.0 +
        textureLod(src_tex, uv + vec2(-ts.x,  0.0 ), 0.0).rgb * 2.0 +
        textureLod(src_tex, uv + vec2( 0.0,   0.0 ), 0.0).rgb * 4.0 +
        textureLod(src_tex, uv + vec2( ts.x,  0.0 ), 0.0).rgb * 2.0 +
        textureLod(src_tex, uv + vec2(-ts.x,  ts.y), 0.0).rgb * 1.0 +
        textureLod(src_tex, uv + vec2( 0.0,   ts.y), 0.0).rgb * 2.0 +
        textureLod(src_tex, uv + vec2( ts.x,  ts.y), 0.0).rgb * 1.0;
    vec3 upsampled = s / 16.0;

    vec3 dst = imageLoad(dst_image, p).rgb;
    imageStore(dst_image, p, vec4(dst + upsampled * strength, 1.0));
}
