#version 460 core
#include "common/subgroup.glsl"
#include "common/queue.glsl"
layout(local_size_x = NUM_QUEUES) in;

// Reads the current queue counters and writes a matching glDispatchCompute-Indirect
// arg triple per queue slot. Called before each group of shade/trace dispatches so
// they only launch the workgroups they actually need (huge savings at late bounces
// where 95% of paths have died).

layout(std430, binding = 23) restrict writeonly buffer DispatchArgsBuffer {
    uvec4 dispatch_args[NUM_QUEUES]; // uvec4 (with .w unused) keeps 16-byte std430 alignment
};

// All shade/trace/traceShadow kernels are `local_size_x = 64`. Hardcoded to keep
// this kernel branchless.
const uint LOCAL_SIZE = 64u;

// Bitmask of counter slots to zero after their dispatch args have been written.
//
// The counter clears used to be one glNamedBufferSubData call per queue per bounce —
// ~200 driver round-trips per frame at 32 bounces, each one a client-side buffer update
// that also had to be ordered against shader writes with GL_BUFFER_UPDATE_BARRIER_BIT.
// This kernel already runs at exactly the points where a queue has just been drained and
// already has the counter bound, so it does the zeroing itself.
//
// A slot may only be cleared once every kernel that reads it as a loop bound has run:
// the shade kernels bound on hit_*, trace_shadow on shadow, trace on ray. The two
// dispatches per bounce therefore clear different halves — see PathTracerPass::execute.
layout(location = 0) uniform uint clear_mask;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= NUM_QUEUES) return;

    uint c = q_count[i];
    uint g = (c + LOCAL_SIZE - 1u) / LOCAL_SIZE;
    dispatch_args[i] = uvec4(g, 1u, 1u, 0u);

    // Each thread owns exactly one slot, so this races with nothing.
    if ((clear_mask & (1u << i)) != 0u) {
        q_count[i] = 0u;
    }
}
