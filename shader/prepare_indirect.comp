#version 460 core
#include "common/subgroup.glsl"
#include "common/host_shared.glsl"
layout(local_size_x = NUM_QUEUES) in;
#include "common/queue.glsl"

// Turns each queue counter into glDispatchComputeIndirect args, so shade/trace dispatches scale
// with live paths rather than pixels.

layout(std430, binding = BIND_DISPATCH_ARGS) restrict writeonly buffer DispatchArgsBuffer {
    uvec4 dispatch_args[NUM_QUEUES]; // uvec4 (with .w unused) keeps 16-byte std430 alignment
};

// Keep in sync with the queue kernels' local_size_x.
const uint LOCAL_SIZE = 64u;

// A slot may be cleared only after every kernel bounded by it has run, so the two dispatches per bounce
// clear different halves.
layout(location = 0) uniform uint clear_mask;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= NUM_QUEUES) return;

    uint c = q_count[i];
    uint g  = (c + LOCAL_SIZE - 1u) / LOCAL_SIZE;
    uint gx = min(g, QUEUE_MAX_GROUPS_X);
    uint gy = (g + QUEUE_MAX_GROUPS_X - 1u) / QUEUE_MAX_GROUPS_X;
    dispatch_args[i] = uvec4(gx, max(gy, 1u), 1u, 0u);

    if ((clear_mask & (1u << i)) != 0u) {
        q_count[i] = 0u;
    }
}
