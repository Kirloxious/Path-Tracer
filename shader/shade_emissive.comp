#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/scene_buffers.glsl"
#include "common/clamp.glsl"
#include "common/lights.glsl"


// Which light group owns `tri_idx`. Groups are consecutive runs, so `begin` is strictly
// increasing and a fixed-step binary search finds it without divergent trip counts.
int find_owning_group(int tri_idx) {
    if (num_light_groups <= 0) return -1;

    // Largest g such that light_groups[g].begin <= tri_idx.
    int lo = 0;
    int hi = num_light_groups - 1;
    while (lo < hi) {
        int mid = (lo + hi + 1) >> 1;
        if (light_groups[mid].begin <= tri_idx) lo = mid;
        else hi = mid - 1;
    }

    LightGroup grp = light_groups[lo];
    return (tri_idx >= grp.begin && tri_idx < grp.begin + grp.count) ? lo : -1;
}

void main() {
    uint qid = queue_thread_index();
    if (qid >= hit_emissive_count) return;
    uint pid = hit_emissive_idx[qid];

    PathState s        = states[pid];
    Material  mat      = mats[s.hit_matid];
    bool      prev_non_specular = (s.flags & FLAG_PREV_NON_SPECULAR) != 0u;
    bool      restir_handled    = (s.flags & FLAG_RESTIR_HANDLED) != 0u;
    bool      is_primary = (s.bounce == 0u);

    // The previous vertex's reservoir already estimated its whole area-light integral.
    if (restir_handled) {
        states[pid] = s;
        return;
    }

    // One-sided, like every other light estimator. A gbuffer primary has no triangle and is
    // always the visible side.
    if (s.hit_triangle_idx != NO_TRIANGLE) {
        if (!light_faces(triangles[s.hit_triangle_idx], s.ray_dir)) {
            states[pid] = s;
            return;
        }
    }

    // Balance heuristic against the previous vertex's NEE; weight 1 where none could have
    // produced this direction (a primary hit, a delta scatter).
    float weight = 1.0;
    if (!is_primary && prev_non_specular && num_light_groups > 0) {
        int gi = find_owning_group(int(s.hit_triangle_idx));
        if (gi >= 0) {
            // The direction NEE would have drawn from the previous vertex is this ray's own.
            vec3  d                  = s.hit_point - s.ray_origin;
            float light_pdf_combined = light_solid_angle_pdf(triangles[s.hit_triangle_idx], light_groups[gi], s.ray_dir, dot(d, d));
            if (light_pdf_combined > 0.0 && (s.pdf_bsdf + light_pdf_combined) > 0.0) {
                weight = s.pdf_bsdf / (s.pdf_bsdf + light_pdf_combined);
            }
        }
    }

    // A primary hit is the authored radiance, not an estimator output, so it is unclamped.
    vec3 contribution = s.throughput * material_emission(mat) * weight;
    s.radiance += is_primary ? contribution : clamp_indirect(contribution);
    states[pid] = s;
}
