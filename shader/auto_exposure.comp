#version 460 core
layout(local_size_x = 256) in;

#include "common/host_shared.glsl"

// Reduces the histogram to a smoothed exposure. 256 bins are few enough that a serial loop on
// thread 0 is no slower than a tree reduction.

layout(std430, binding = BIND_HISTOGRAM) buffer HistogramBuffer {
    uint bins[256];
} hist;

layout(std430, binding = BIND_EXPOSURE) buffer ExposureBuffer {
    float exposure;
    float _padding[3];
} expo;

layout(location = 0) uniform float log_luma_min;
layout(location = 1) uniform float log_luma_range;
layout(location = 2) uniform float dt;
layout(location = 3) uniform float tau; // EMA time constant in seconds
layout(location = 4) uniform float target_luma; // desired luminance (e.g. 0.18 middle-gray)
layout(location = 5) uniform float min_exposure;
layout(location = 6) uniform float max_exposure;
layout(location = 7) uniform int reset_exposure; // 1 → skip EMA, snap directly
layout(location = 8) uniform float low_percentile;  // fraction of non-black pixels dropped from the dark end
layout(location = 9) uniform float high_percentile; // ... and everything past this from the bright end

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        // Bin 0 holds essentially-black pixels, which would blow out dark scenes.
        float total = 0.0;
        for (uint i = 1u; i < 256u; ++i) {
            total += float(hist.bins[i]);
        }

        // Mean log-luminance over the pixels ranked between the two percentiles. A bin
        // straddling a cut contributes only its share inside it.
        float lo    = low_percentile * total;
        float hi    = high_percentile * total;
        float below = 0.0;
        float t_sum = 0.0;
        float c_sum = 0.0;
        for (uint i = 1u; i < 256u; ++i) {
            float count = float(hist.bins[i]);
            float kept  = clamp(below + count, lo, hi) - clamp(below, lo, hi);
            // Bin i holds t in [(i - 1) / 254, i / 254); its centre, not its lower edge.
            t_sum += kept * ((float(i) - 0.5) / 254.0);
            c_sum += kept;
            below += count;
        }

        float t        = (c_sum > 0.0) ? (t_sum / c_sum) : 0.5;
        float avg_luma = exp2(log_luma_min + t * log_luma_range);

        float target_exposure = clamp(target_luma / max(avg_luma, 1e-4), min_exposure, max_exposure);

        // Smoothed in log2, so rises and drops of equal stops adapt equally fast.
        float alpha    = clamp(1.0 - exp(-dt / max(tau, 1e-3)), 0.0, 1.0);
        float log_next = mix(log2(max(expo.exposure, 1e-6)), log2(target_exposure), alpha);
        expo.exposure  = (reset_exposure == 1) ? target_exposure : exp2(log_next);
    }

    memoryBarrierBuffer();
    barrier();
    hist.bins[gl_LocalInvocationIndex] = 0u;
}
