#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/shade_surface.glsl"

// Diffuse and Specular share one queue and kernel — one BSDF covers both, and it saves an SSBO
// block in every kernel that includes queue.glsl.
void main() {
    uint qid = queue_thread_index();
    if (qid >= hit_opaque_count) return;
    shade_surface(hit_opaque_idx[qid]);
}
