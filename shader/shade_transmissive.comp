#version 460 core
#include "common/subgroup.glsl"
layout(local_size_x = 64) in;

#include "common/path_state.glsl"
#include "common/queue.glsl"
#include "common/scene_buffers.glsl"
#include "common/rng.glsl"
#include "common/geom.glsl"
#include "common/bsdf.glsl"
#include "common/nee.glsl"
#include "common/path_continue.glsl"


void main() {
    uint qid = queue_thread_index();
    if (qid >= hit_transmissive_count) return;
    uint pid = hit_transmissive_idx[qid];

    PathState s   = states[pid];
    Sampler   smp = path_sampler(s);

    Material mat        = mats[s.hit_matid];
    vec3     N          = s.hit_normal;
    vec3     V          = normalize(-s.ray_dir);
    bool     front_face = (s.flags & FLAG_FRONT_FACE) != 0u;
    float    eta        = front_face ? (1.0 / mat.ior) : mat.ior;

    // Beer-Lambert over the segment just travelled inside the medium, with base_color read as the
    // transmittance over one world unit.
    if (!front_face) {
        float dist = length(s.hit_point - s.ray_origin);
        s.throughput *= pow(max(mat.base_color, vec3(1e-3)), vec3(dist));
    }

    // NEE on the reflection lobe, from outside only: inside, reaching a light means refracting
    // out, which an explicit direction sample cannot account for.
    uint nee_flags = 0u;
    if (front_face) {
        NeeSurface surf;
        surf.P          = s.hit_point;
        surf.N          = N;
        surf.V          = V;
        surf.matid      = s.hit_matid;
        surf.eta        = eta;
        surf.dielectric = true;

        ShadowState ss;
        nee_flags = nee_schedule(surf, s.throughput, true, num_light_groups, smp, s.bounce * SAMPLER_DIMS_PER_BOUNCE, ss);
        if (ss.nee_valid != 0.0 || ss.env_valid != 0.0) {
            shadow_states[pid] = ss;
            shadow_queue_push(pid);
        }
    }

    sampler_set_dim(smp, s.bounce * SAMPLER_DIMS_PER_BOUNCE + 6u);

    vec3  dir;
    vec3  weight;
    bool  transmitted;
    float pdf;
    bool  alive = bsdf_sample_transmissive(mat, N, V, eta, smp, dir, weight, transmitted, pdf);

    if (alive) {
        s.throughput *= weight;
        s.pdf_bsdf = pdf;

        // The specular prefix ends: the reflect/refract coin flip is one restir_initial's walk
        // cannot follow. A refracted ray drops the NEE flags — NEE only covered reflection.
        alive = path_continue(s, smp, dir, false, transmitted ? 0u : nee_flags);
    }

    path_commit(pid, s, alive);
}
