#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/rng.glsl" // MAT_* constants live here
#include "common/uniform_locations.glsl"
#include "common/bvh_traversal.glsl"
#include "common/gbuffer.glsl"

layout(rgb10_a2, binding = 0) writeonly uniform image2D dst_image;
layout(rgba32f, binding = 1) readonly  uniform image2D accum_image;

layout(location = 0) uniform ivec2 image_size;
layout(location = 1) uniform int   aov_mode;
layout(location = 2) uniform float depth_max;
layout(location = 3) uniform float bvh_cost_max;
// bvh_root_index comes from common/bvh_traversal.glsl, which this shader now includes for
// world_hit_cost() rather than keeping its own copy of the traversal loop.

// Keep in sync with AovMode in src/render/render_settings.h.
const int AOV_NONE         = 0;
const int AOV_WORLD_NORMAL = 1;
const int AOV_LINEAR_DEPTH = 2;
const int AOV_ALBEDO       = 3;
const int AOV_MATERIAL_ID  = 4;
const int AOV_BVH_COST     = 5;
const int AOV_VARIANCE     = 6;

// Turbo-ish colormap: cheap analytic approximation used for scalar heatmaps.
// Domain [0,1] → smooth blue → cyan → green → yellow → red ramp.
vec3 heatmap(float t) {
    t = clamp(t, 0.0, 1.0);
    vec3 c = vec3(0.0);
    c.r = smoothstep(0.4, 1.0, t);
    c.g = smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(0.7, 1.0, t));
    c.b = smoothstep(0.0, 0.3, t) * (1.0 - smoothstep(0.4, 0.7, t)) + smoothstep(0.9, 1.0, t) * 0.4;
    return c;
}

// Hash a material index into a stable pastel color.
vec3 idHash(uint id) {
    uint h = id * 2654435761u;
    return vec3(
        float((h >> 0)  & 0xFFu) / 255.0,
        float((h >> 8)  & 0xFFu) / 255.0,
        float((h >> 16) & 0xFFu) / 255.0
    ) * 0.75 + 0.25; // shift into [0.25, 1.0] for visibility
}

// 3x3 luminance variance in the current-frame accumulated buffer. Larger =
// noisier / less-converged neighborhood.
float localVariance(ivec2 p) {
    float sum  = 0.0;
    float sum2 = 0.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            ivec2 q = clamp(p + ivec2(i, j), ivec2(0), image_size - 1);
            vec3  c = imageLoad(accum_image, q).rgb;
            float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
            sum  += l;
            sum2 += l * l;
        }
    }
    float mean = sum / 9.0;
    return max(sum2 / 9.0 - mean * mean, 0.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= image_size.x || p.y >= image_size.y) return;

    vec3 n_raw = gbuffer_raw_normal(p);
    bool miss  = gbuffer_is_sky(n_raw);

    vec3 rgb = vec3(0.0);

    switch (aov_mode) {
        case AOV_WORLD_NORMAL: {
            rgb = miss ? vec3(0.0) : normalize(n_raw) * 0.5 + 0.5;
            break;
        }
        case AOV_LINEAR_DEPTH: {
            if (miss) {
                rgb = vec3(0.0);
            } else {
                float d = length(gbuffer_world_pos(p, image_size) - camera_position);
                rgb = vec3(clamp(d / max(depth_max, 1e-4), 0.0, 1.0));
            }
            break;
        }
        case AOV_ALBEDO: {
            if (miss) {
                rgb = vec3(0.0);
            } else {
                Material m = mats[gbuffer_matid(p)];
                // For emissives, the "color" slot is unused — fall back to emission
                // clamped into a legible range.
                rgb = (m.type == MAT_EMISSIVE) ? clamp(m.emission, 0.0, 1.0) : m.color;
            }
            break;
        }
        case AOV_MATERIAL_ID: {
            rgb = miss ? vec3(0.0) : idHash(gbuffer_matid(p));
            break;
        }
        case AOV_BVH_COST: {
            // Reconstruct the primary view ray from pixel coords so sky pixels
            // (no gbuffer hit) still get a meaningful cost.
            vec2 ndc = (vec2(p) + 0.5) / vec2(image_size) * 2.0 - 1.0;
            // Reversed-Z with a [0,1] clip range puts the near plane at ndc.z = 1.
        vec4 clip = inv_proj_matrix * vec4(ndc.x, ndc.y, 1.0, 1.0);
            vec3 dir  = normalize(mat3(inv_view_matrix) * normalize(clip.xyz));
            Ray  probe;
            probe.origin    = camera_position;
            probe.direction = dir;
            uint cost       = world_hit_cost(probe, 0.001, 1e30);
            rgb = heatmap(float(cost) / max(bvh_cost_max, 1.0));
            break;
        }
        case AOV_VARIANCE: {
            // Denoiser-friendly signal: log-compressed so a small noise floor is
            // still visible without saturating on fireflies.
            float v = localVariance(p);
            rgb = heatmap(clamp(log(1.0 + v * 100.0) * 0.25, 0.0, 1.0));
            break;
        }
        default:
            return; // AOV_NONE — leave display untouched
    }

    imageStore(dst_image, p, vec4(rgb, 1.0));
}
