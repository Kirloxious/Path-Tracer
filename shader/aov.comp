#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/rng.glsl" // MAT_* constants live here

layout(rgba32f, binding = 0) writeonly uniform image2D dst_image;
layout(rgba32f, binding = 1) readonly  uniform image2D accum_image;
layout(binding = 5) uniform sampler2D gbuf_pos_matid_tex;
layout(binding = 6) uniform sampler2D gbuf_normal_tex;

layout(location = 0) uniform ivec2 image_size;
layout(location = 1) uniform int   aov_mode;
layout(location = 2) uniform float depth_max;
layout(location = 3) uniform float bvh_cost_max;
// bvh_traversal.glsl declares location=8 for `bvh_root_index`. We only need the
// root index (no full HitRecord traversal) so we duplicate the uniform locally
// to avoid pulling the header in for the whole shading struct.
layout(location = 8) uniform int   bvh_root_index;

// Keep in sync with AovMode in src/render/render_settings.h.
const int AOV_NONE         = 0;
const int AOV_WORLD_NORMAL = 1;
const int AOV_LINEAR_DEPTH = 2;
const int AOV_ALBEDO       = 3;
const int AOV_MATERIAL_ID  = 4;
const int AOV_BVH_COST     = 5;
const int AOV_VARIANCE     = 6;

// Turbo-ish colormap: cheap analytic approximation used for scalar heatmaps.
// Domain [0,1] → smooth blue → cyan → green → yellow → red ramp.
vec3 heatmap(float t) {
    t = clamp(t, 0.0, 1.0);
    vec3 c = vec3(0.0);
    c.r = smoothstep(0.4, 1.0, t);
    c.g = smoothstep(0.0, 0.5, t) * (1.0 - smoothstep(0.7, 1.0, t));
    c.b = smoothstep(0.0, 0.3, t) * (1.0 - smoothstep(0.4, 0.7, t)) + smoothstep(0.9, 1.0, t) * 0.4;
    return c;
}

// Hash a material index into a stable pastel color.
vec3 idHash(uint id) {
    uint h = id * 2654435761u;
    return vec3(
        float((h >> 0)  & 0xFFu) / 255.0,
        float((h >> 8)  & 0xFFu) / 255.0,
        float((h >> 16) & 0xFFu) / 255.0
    ) * 0.75 + 0.25; // shift into [0.25, 1.0] for visibility
}

// Count BVH node AABB tests + successful triangle intersections walking the
// stackless BVH for the given primary ray. Mirrors world_hit_stackless in
// bvh_traversal.glsl but strips out the HitRecord bookkeeping.
uint bvhCost(vec3 origin, vec3 dir) {
    vec3  inv_dir = 1.0 / dir;
    vec3  neg_ood = -origin * inv_dir;
    int   idx     = bvh_root_index;
    float closest = 1e30;
    uint  cost    = 0u;

    while (idx >= 0) {
        BVHNodeFlat node = nodes[idx];
        cost += 1u;

        vec3  t1     = node.aabb_min.xyz * inv_dir + neg_ood;
        vec3  t2     = node.aabb_max.xyz * inv_dir + neg_ood;
        float t_near = max(max(min(t1.x, t2.x), min(t1.y, t2.y)), min(t1.z, t2.z));
        float t_far  = min(min(max(t1.x, t2.x), max(t1.y, t2.y)), max(t1.z, t2.z));
        bool  hit    = t_near <= t_far && t_far > 0.001 && t_near < closest;

        if (hit) {
            if (node.meta.x == -1) {
                // Leaf: perform the triangle intersect to update `closest`,
                // giving early-out savings that real traversal enjoys.
                Triangle tri = triangles[node.meta.z];
                cost += 2u; // triangle test costs more than an AABB test — weight it
                vec3  v0 = vertices[tri.indices.x].position;
                vec3  h  = cross(dir, tri.e2);
                float a  = dot(tri.e1, h);
                if (abs(a) >= 1e-8) {
                    float f = 1.0 / a;
                    vec3  s = origin - v0;
                    float u = f * dot(s, h);
                    if (u >= 0.0 && u <= 1.0) {
                        vec3  q = cross(s, tri.e1);
                        float v = f * dot(dir, q);
                        if (v >= 0.0 && u + v <= 1.0) {
                            float t = f * dot(tri.e2, q);
                            if (t > 0.001 && t < closest) closest = t;
                        }
                    }
                }
                idx = node.meta.w;
            } else {
                idx = node.meta.x;
            }
        } else {
            idx = node.meta.w;
        }
    }
    return cost;
}

// 3x3 luminance variance in the current-frame accumulated buffer. Larger =
// noisier / less-converged neighborhood.
float localVariance(ivec2 p) {
    float sum  = 0.0;
    float sum2 = 0.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            ivec2 q = clamp(p + ivec2(i, j), ivec2(0), image_size - 1);
            vec3  c = imageLoad(accum_image, q).rgb;
            float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
            sum  += l;
            sum2 += l * l;
        }
    }
    float mean = sum / 9.0;
    return max(sum2 / 9.0 - mean * mean, 0.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= image_size.x || p.y >= image_size.y) return;

    vec4  pm    = texelFetch(gbuf_pos_matid_tex, p, 0);
    vec3  n_raw = texelFetch(gbuf_normal_tex,    p, 0).xyz;
    bool  miss  = dot(n_raw, n_raw) < 0.5;

    vec3 rgb = vec3(0.0);

    switch (aov_mode) {
        case AOV_WORLD_NORMAL: {
            rgb = miss ? vec3(0.0) : normalize(n_raw) * 0.5 + 0.5;
            break;
        }
        case AOV_LINEAR_DEPTH: {
            if (miss) {
                rgb = vec3(0.0);
            } else {
                float d = length(pm.xyz - camera_position);
                rgb = vec3(clamp(d / max(depth_max, 1e-4), 0.0, 1.0));
            }
            break;
        }
        case AOV_ALBEDO: {
            if (miss) {
                rgb = vec3(0.0);
            } else {
                uint matid = floatBitsToUint(pm.w);
                Material m = mats[matid];
                // For emissives, the "color" slot is unused — fall back to emission
                // clamped into a legible range.
                rgb = (m.type == MAT_EMISSIVE) ? clamp(m.emission, 0.0, 1.0) : m.color;
            }
            break;
        }
        case AOV_MATERIAL_ID: {
            rgb = miss ? vec3(0.0) : idHash(floatBitsToUint(pm.w));
            break;
        }
        case AOV_BVH_COST: {
            // Reconstruct the primary view ray from pixel coords so sky pixels
            // (no gbuffer hit) still get a meaningful cost.
            vec2 ndc = (vec2(p) + 0.5) / vec2(image_size) * 2.0 - 1.0;
            vec4 clip = inv_proj_matrix * vec4(ndc.x, ndc.y, -1.0, 1.0);
            vec3 dir  = normalize(mat3(inv_view_matrix) * normalize(clip.xyz));
            uint cost = bvhCost(camera_position, dir);
            rgb = heatmap(float(cost) / max(bvh_cost_max, 1.0));
            break;
        }
        case AOV_VARIANCE: {
            // Denoiser-friendly signal: log-compressed so a small noise floor is
            // still visible without saturating on fireflies.
            float v = localVariance(p);
            rgb = heatmap(clamp(log(1.0 + v * 100.0) * 0.25, 0.0, 1.0));
            break;
        }
        default:
            return; // AOV_NONE — leave display untouched
    }

    imageStore(dst_image, p, vec4(rgb, 1.0));
}
