#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/math.glsl"

// 13-tap downsample with partial Karis average (Jimenez, "Next Generation Post Processing in
// Call of Duty: Advanced Warfare", SIGGRAPH 2014). Bilinear taps cover a 4x4 footprint.

layout(binding = 0) uniform sampler2D src_tex;             // source mip (or hdr on the first pass)
layout(rgba16f, binding = 1) writeonly uniform image2D dst_image; // destination mip

layout(location = 0) uniform ivec2 dst_size;
layout(location = 1) uniform int   apply_threshold; // 1 on the first (hdr → mip0) pass, 0 elsewhere
layout(location = 2) uniform float threshold;       // soft knee luminance
layout(location = 3) uniform float knee;            // soft-knee width

// 1/(1 + luma)-weighted mean, so a single firefly cannot dominate its quad.
vec3 karis_average(vec3 c0, vec3 c1, vec3 c2, vec3 c3) {
    float l0 = 1.0 / (1.0 + luminance(c0));
    float l1 = 1.0 / (1.0 + luminance(c1));
    float l2 = 1.0 / (1.0 + luminance(c2));
    float l3 = 1.0 / (1.0 + luminance(c3));
    float wsum = l0 + l1 + l2 + l3;
    return (c0 * l0 + c1 * l1 + c2 * l2 + c3 * l3) / max(wsum, 1e-6);
}

// Soft-knee threshold, so bloom fades in rather than stepping on at `threshold`.
vec3 prefilter(vec3 c) {
    float l = max(max(c.r, c.g), c.b);
    float soft = l - threshold + knee;
    soft = clamp(soft, 0.0, 2.0 * knee);
    soft = soft * soft / max(4.0 * knee + 1e-6, 1e-6);
    float contrib = max(soft, l - threshold) / max(l, 1e-6);
    return c * contrib;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= dst_size.x || p.y >= dst_size.y) return;

    // Offsets below are in source texels.
    vec2  uv = (vec2(p) + 0.5) / vec2(dst_size);
    vec2  ts = 1.0 / vec2(textureSize(src_tex, 0));

    // a..i: 3x3 grid two texels apart; j..m: the inner diagonal taps.
    vec3 a = textureLod(src_tex, uv + ts * vec2(-2.0, -2.0), 0.0).rgb;
    vec3 b = textureLod(src_tex, uv + ts * vec2( 0.0, -2.0), 0.0).rgb;
    vec3 c = textureLod(src_tex, uv + ts * vec2( 2.0, -2.0), 0.0).rgb;
    vec3 d = textureLod(src_tex, uv + ts * vec2(-2.0,  0.0), 0.0).rgb;
    vec3 e = textureLod(src_tex, uv + ts * vec2( 0.0,  0.0), 0.0).rgb;
    vec3 f = textureLod(src_tex, uv + ts * vec2( 2.0,  0.0), 0.0).rgb;
    vec3 g = textureLod(src_tex, uv + ts * vec2(-2.0,  2.0), 0.0).rgb;
    vec3 h = textureLod(src_tex, uv + ts * vec2( 0.0,  2.0), 0.0).rgb;
    vec3 i = textureLod(src_tex, uv + ts * vec2( 2.0,  2.0), 0.0).rgb;
    vec3 j = textureLod(src_tex, uv + ts * vec2(-1.0, -1.0), 0.0).rgb;
    vec3 k = textureLod(src_tex, uv + ts * vec2( 1.0, -1.0), 0.0).rgb;
    vec3 l = textureLod(src_tex, uv + ts * vec2(-1.0,  1.0), 0.0).rgb;
    vec3 m = textureLod(src_tex, uv + ts * vec2( 1.0,  1.0), 0.0).rgb;

    // Karis on the first downsample only: that is the one pass that can see a single-pixel
    // firefly, and the weighting loses energy, which would compound at every mip.
    vec3 result;
    if (apply_threshold == 1) {
        vec3 box_center = karis_average(j, k, l, m);              // inner 2x2 gets 0.5 weight
        vec3 box_tl     = karis_average(a, b, d, e);
        vec3 box_tr     = karis_average(b, c, e, f);
        vec3 box_bl     = karis_average(d, e, g, h);
        vec3 box_br     = karis_average(e, f, h, i);
        result = box_center * 0.5 + (box_tl + box_tr + box_bl + box_br) * 0.125;
    } else {
        vec3 box_center = (j + k + l + m) * 0.25;
        vec3 box_tl     = (a + b + d + e) * 0.25;
        vec3 box_tr     = (b + c + e + f) * 0.25;
        vec3 box_bl     = (d + e + g + h) * 0.25;
        vec3 box_br     = (e + f + h + i) * 0.25;
        result = box_center * 0.5 + (box_tl + box_tr + box_bl + box_br) * 0.125;
    }

    if (apply_threshold == 1) {
        result = prefilter(result);
    }

    imageStore(dst_image, p, vec4(result, 1.0));
}
