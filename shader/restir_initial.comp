#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/bvh_traversal.glsl"
#include "common/rng.glsl"
#include "common/restir_common.glsl"
#include "common/lights.glsl"
#include "common/restir_surface.glsl"
#include "common/gbuffer.glsl"
#include "common/geom.glsl"

layout(std430, binding = BIND_RESERVOIRS_CURRENT) restrict buffer RestirReservoirsCurrent {
    Reservoir reservoirs[];
};

layout(std430, binding = BIND_SURFACES_CURRENT) restrict writeonly buffer RestirSurfaceCurrent {
    RestirSurface surfaces[];
};


layout(location = 0) uniform int m_initial;

// Mirror bounces the walk follows before giving up; bounds facing mirrors.
const int MAX_MIRROR_DEPTH = 4;

// Zeroes the whole record, not just `valid`, so a consumer bug reads an obvious zero rather
// than last frame's plausible garbage.
void surface_invalidate(uint pid) {
    RestirSurface s;
    s.position = vec3(0.0);
    s.valid = 0u;
    s.normal = vec3(0.0);
    s.matid = 0u;
    s.view_dir = vec3(0.0);
    s.offset_n = 0u;
    surfaces[pid] = s;
}

// One RIS candidate, with its solid-angle source pdf and target pdf. Unshadowed — visibility is
// tested once, on the winner. @return false when the candidate has zero target pdf.
bool sample_candidate(vec3 P,
    vec3 N,
    vec3 V,
    uint matid,
    inout Sampler smp,
    out uint out_tri_idx,
    out vec2 out_bary,
    out float out_source_pdf_omega,
    out float out_target_pdf) {
    int        gi  = sample_light_group(num_light_groups, smp);
    LightGroup grp = light_groups[gi];
    if (grp.total_area <= 0.0 || grp.count <= 0) return false;

    int      lo   = sample_light_triangle(grp, smp);
    Triangle tri  = triangles[lo];
    vec2     bary = sample_triangle_bary(smp);

    vec3  d         = light_point(tri, bary) - P;
    float dist2     = dot(d, d);
    vec3  light_dir = d * inversesqrt(dist2);

    float source_pdf_omega = light_solid_angle_pdf(tri, grp, light_dir, dist2);
    if (source_pdf_omega <= 0.0) return false;

    float p_hat = restir_p_hat(N, V, matid, tri, light_dir);
    if (p_hat <= 0.0) return false;

    out_tri_idx = uint(lo);
    out_bary = bary;
    out_source_pdf_omega = source_pdf_omega;
    out_target_pdf = p_hat;
    return true;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    Reservoir r;
    reservoir_clear(r);

    if (num_light_groups <= 0) {
        reservoirs[pid] = r;
        surface_invalidate(pid);
        return;
    }

    vec3 n = gbuffer_raw_normal(px);

    if (gbuffer_is_sky(n)) {
        reservoirs[pid] = r;
        surface_invalidate(pid);
        return;
    }

    uint     matid = gbuffer_matid(px);
    Material mat   = mats[matid];
    vec3     P     = gbuffer_world_pos(px, image_size);
    vec3     N     = normalize(n);

    // Follow perfect mirrors to the first surface that can anchor, and resample there. Only a
    // mirror's plain reflect() lets this walk and the path tracer provably land on the same
    // vertex; a rough or transmissive scatter would diverge.
    vec3 ray_dir = normalize(P - camera_position);
    // Tracked separately from the shading normal N, which drives reflect() and ends up in the
    // resampling surface. The walk must spawn every ray exactly as path_continue() does
    // (surface_ray_origin, skipping the triangle left) or it lands on a different vertex.
    vec3 offset_n = N;
    int  tri_prev = NO_SKIP_TRI;

    for (int depth = 0; depth < MAX_MIRROR_DEPTH; ++depth) {
        // Must agree exactly with bsdf_sample()'s pure-mirror branch.
        if (mat.type != MAT_SPECULAR || !bsdf_is_mirror(mat)) {
            break;
        }

        Ray refl;
        refl.direction = reflect(ray_dir, N);
        refl.origin = (tri_prev == NO_SKIP_TRI) ? offset_primary_origin(P, offset_n, refl.direction) : offset_ray_origin(P, offset_n, refl.direction);

        HitRecord hit;
        int tri_index;
        if (!world_hit(refl, 0.0, 1e30, tri_prev, hit, tri_index)) {
            reservoirs[pid] = r;
            surface_invalidate(pid);
            return;
        }

        ray_dir = refl.direction;
        P = hit.point;
        N = hit.normal;
        offset_n = triangle_geom_normal(uint(tri_index));
        tri_prev = tri_index;
        matid = hit.mat_index;
        mat = mats[matid];
    }

    if (!restir_can_anchor(mat)) {
        reservoirs[pid] = r;
        surface_invalidate(pid);
        return;
    }

    vec3 V = normalize(-ray_dir);

    RestirSurface surf;
    surf.position = P;
    surf.valid = 1u;
    surf.normal = N;
    surf.matid = matid;
    surf.view_dir = V;
    surf.offset_n = restir_pack_normal(offset_n);
    surfaces[pid] = surf;

    // Candidates draw from the stratified sampler; the acceptance tests use white noise, since a
    // shared low-discrepancy stream would only correlate the selections.
    Sampler smp = sampler_init(sampler_seed(pid, run_seed + 0x5419u), frame_index, 0u);
    uint    rng = pcg_seed(pid, time_seed, RESTIR_RNG_INITIAL);

    int M = max(1, m_initial);
    for (int i = 0; i < M; ++i) {
        // Fixed dimensions per candidate, so each one's samples stratify across frames.
        sampler_set_dim(smp, uint(i) * 3u);

        uint tri_idx;
        vec2 bary;
        float source_pdf_omega;
        float p_hat;
        if (!sample_candidate(P, N, V, matid, smp, tri_idx, bary, source_pdf_omega, p_hat)) {
            // Still counts toward M: it was drawn from the source pdf, and RIS stays unbiased.
            r.M += 1.0;
            continue;
        }
        float w_i = p_hat / source_pdf_omega;
        reservoir_update(r, tri_idx, bary, p_hat, w_i, rng);
    }

    // Not shadow-tested: restir_temporal always runs next and tests whichever sample survives it.
    reservoir_finalize(r, r.M);
    reservoirs[pid] = r;
}
