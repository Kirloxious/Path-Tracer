#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

#include "common/scene_buffers.glsl"
#include "common/bvh_traversal.glsl"
#include "common/rng.glsl"
#include "common/restir_common.glsl"
#include "common/restir_surface.glsl"
#include "common/gbuffer.glsl"

layout(std430, binding = BIND_RESERVOIRS_CURRENT) restrict buffer RestirReservoirsCurrent {
    Reservoir reservoirs[];
};

layout(std430, binding = BIND_RESERVOIRS_PREV) restrict readonly buffer RestirReservoirsPrev {
    Reservoir prev_reservoirs[];
};

layout(std430, binding = BIND_SURFACES_CURRENT) restrict readonly buffer RestirSurfaceCurrent {
    RestirSurface surfaces[];
};

layout(std430, binding = BIND_SURFACES_PREV) restrict readonly buffer RestirSurfacePrev {
    RestirSurface prev_surfaces[];
};

layout(location = 0) uniform int m_cap;

// Combines last frame's reservoir into `cur`, or leaves it untouched when there is no valid
// history for this pixel.
void combine_history(ivec2 px, uint pid, in RestirSurface cur_surf, inout Reservoir cur) {
    // Reprojection follows the primary hit — which pixel saw this last frame — while validation
    // compares resampling surfaces, which past a mirror are elsewhere.
    vec3 primary_pos = gbuffer_world_pos(px, image_size);

    vec3 P = cur_surf.position;
    vec3 N = cur_surf.normal;
    vec3 V = cur_surf.view_dir;

    vec4 prev_clip = prev_view_proj_matrix * vec4(primary_pos, 1.0);
    if (prev_clip.w <= 0.0) return;
    vec3 prev_ndc = prev_clip.xyz / prev_clip.w;
    if (any(lessThan(prev_ndc.xy, vec2(-1.0))) || any(greaterThan(prev_ndc.xy, vec2(1.0)))) return;

    vec2  prev_uv = prev_ndc.xy * 0.5 + 0.5;
    ivec2 prev_px = clamp(ivec2(prev_uv * vec2(image_size)), ivec2(0), image_size - 1);
    uint  prev_pid = uint(prev_px.y * image_size.x + prev_px.x);

    RestirSurface prev_surf = prev_surfaces[prev_pid];
    if (!restir_surfaces_similar(cur_surf, prev_surf)) return;

    Reservoir prev = prev_reservoirs[prev_pid];
    if (prev.M <= 0.0 || prev.light_tri_idx == RESTIR_INVALID_TRI) return;

    prev.M = min(prev.M, float(m_cap));

    // A history sample that cannot light this surface is skipped rather than diluting cur.M.
    float p_hat_prev_at_current = restir_target_pdf(P, N, V, cur_surf.matid, prev.light_tri_idx, prev.bary);
    if (p_hat_prev_at_current <= 0.0) return;

    float own_M = cur.M;

    uint rng = pcg_seed(pid, time_seed, RESTIR_RNG_TEMPORAL);

    reservoir_combine(cur, prev, p_hat_prev_at_current, rng);

    // cur.target_pdf is already the winner's p_hat here; only the history's term needs
    // re-evaluating, at the surface it describes.
    float Z = (cur.target_pdf > 0.0) ? own_M : 0.0;
    if (restir_target_pdf(prev_surf.position, prev_surf.normal, prev_surf.view_dir, prev_surf.matid, cur.light_tri_idx, cur.bary) > 0.0) {
        Z += prev.M;
    }
    reservoir_finalize(cur, Z);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= image_size.x || px.y >= image_size.y) return;
    uint pid = uint(px.y * image_size.x + px.x);

    RestirSurface cur_surf = surfaces[pid];
    if (cur_surf.valid == 0u) return;

    Reservoir cur = reservoirs[pid];
    combine_history(px, pid, cur_surf, cur);

    // The one shadow ray before spatial reuse, whether or not history was combined:
    // restir_initial leaves its winner untested for this pass.
    if (cur.W > 0.0 && cur.light_tri_idx != RESTIR_INVALID_TRI) {
        vec3 sp = light_point(triangles[cur.light_tri_idx], cur.bary);
        if (!is_visible(restir_surface_offset_origin(cur_surf, sp), sp, NO_SKIP_TRI, int(cur.light_tri_idx))) {
            cur.W = 0.0;
        }
    }

    reservoirs[pid] = cur;
}
