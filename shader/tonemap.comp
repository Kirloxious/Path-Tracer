#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform image2D src_image; // HDR
layout(rgb10_a2, binding = 1) writeonly uniform image2D dst_image; // LDR, sRGB-encoded

// Persistent exposure buffer written by AutoExposurePass. When auto-exposure is
// disabled, AutoExposurePass overwrites this with the user's exposure slider so
// tonemap doesn't need to branch.
layout(std430, binding = 30) readonly buffer ExposureBuffer {
    float exposure;
    float _padding[3];
} expo;

layout(location = 0) uniform ivec2 image_size;

// Narkowicz ACES fit — matches ACES filmic in the mid range, clamps highlights.
vec3 aces_tonemap(vec3 c) {
    const float a = 2.51;
    const float b = 0.03;
    const float d = 2.43;
    const float e_ = 0.59;
    const float f = 0.14;
    return clamp((c * (a * c + b)) / (c * (d * c + e_) + f), 0.0, 1.0);
}

vec3 linear_to_srgb(vec3 c) {
    return mix(c * 12.92, pow(c, vec3(1.0 / 2.4)) * 1.055 - 0.055, step(0.0031308, c));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= image_size.x || p.y >= image_size.y) return;

    vec3 hdr = imageLoad(src_image, p).rgb;
    vec3 ldr = aces_tonemap(hdr * expo.exposure);
    ldr = linear_to_srgb(ldr);
    imageStore(dst_image, p, vec4(ldr, 1.0));
}
